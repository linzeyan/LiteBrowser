// LiteBrowser main window.
//
// The web page itself is a native WebView2 child window that Rust places over the `content`
// rectangle. Anything drawn by Slint inside `content` (internal pages, address suggestions) is only
// visible while Rust keeps the WebView hidden, so nothing here pops up over the content area.
//
// The look follows Chrome's 2023 light theme; sizes and colors were measured off Chrome 155
// screenshots at the same window size (tab strip 40, toolbar 46, 34px pill omnibox).

import { LineEdit, ListView, ScrollView, CheckBox, SpinBox, Palette } from "std-widgets.slint";

export enum Page { web, new-tab, bookmarks, history, extensions, settings, import }

export struct TabData {
    title: string,
    url: string,
    loading: bool,
    discarded: bool,
    suspended: bool,
    pinned: bool,
    favicon: image,
    private: bool,
}

export struct LinkData {
    title: string,
    url: string,
    detail: string,
    favicon: image,
}

export struct ImportProfileData {
    // Stable id Rust uses to find the profile again.
    id: int,
    label: string,
    selected: bool,
}

export struct SuggestionData {
    title: string,
    url: string,
    // "search", "url", "bookmark" or "history"
    kind: string,
}

export struct ExtensionData {
    id: string,
    name: string,
    enabled: bool,
}

export struct SettingsData {
    max-live-tabs: int,
    suspend-after-secs: int,
    discard-after-mins: int,
    memory-budget-mb: int,
    adblock: bool,
    disable-gpu: bool,
    restore-session: bool,
    show-bookmarks-bar: bool,
    search-url: string,
    devtools-dock-right: bool,
    mcp-enabled: bool,
}

global Theme {
    out property <color> frame: #dde3e9;
    out property <color> surface: #ffffff;
    // Behind the cards of internal pages.
    out property <color> page: #f3f6fb;
    out property <color> field: #edf2fa;
    out property <color> field-hover: #e2e8f1;
    out property <color> text: #1f1f1f;
    out property <color> icon: #474747;
    out property <color> dim: #5e5e5e;
    out property <color> disabled: #b0b3b6;
    out property <color> hover: #1f1f1f14;
    out property <color> pressed: #1f1f1f24;
    out property <color> row-hover: #1f1f1f0a;
    out property <color> border: #e1e3e1;
    out property <color> outline: #c4c7c5;
    out property <color> separator: #c7c7c7;
    // A hovered background tab, as a solid color so its title fade can blend into it.
    out property <color> tab-hover: #ecf0f3;
    out property <color> private-tab: #46465a;
    out property <color> private-tab-hover: #55556a;
    out property <color> accent: #0b57d0;
    out property <color> danger: #c42b1c;
}

global Icons {
    out property <string> back: "M 19 12 L 5 12 M 11 6 L 5 12 L 11 18";
    out property <string> forward: "M 5 12 L 19 12 M 13 6 L 19 12 L 13 18";
    out property <string> reload: "M 19 12 A 7 7 0 1 1 16.9 7 M 19 3.5 L 19 7.5 L 15 7.5";
    out property <string> close: "M 6 6 L 18 18 M 18 6 L 6 18";
    out property <string> plus: "M 12 5 L 12 19 M 5 12 L 19 12";
    out property <string> star: "M 12 3.5 L 14.6 8.8 L 20.4 9.6 L 16.2 13.7 L 17.2 19.5 L 12 16.8 L 6.8 19.5 L 7.8 13.7 L 3.6 9.6 L 9.4 8.8 Z";
    out property <string> bookmarks: "M 6 3.5 L 18 3.5 L 18 20.5 L 12 16 L 6 20.5 Z";
    out property <string> history: "M 3.5 12 A 8.5 8.5 0 1 0 20.5 12 A 8.5 8.5 0 1 0 3.5 12 M 12 7 L 12 12 L 15.5 14";
    out property <string> puzzle: "M 4 8 L 9 8 A 2.2 2.2 0 1 1 13 8 L 17 8 L 17 12 A 2.2 2.2 0 1 1 17 16 L 17 20 L 4 20 Z";
    // Chrome's ⋮, drawn filled.
    out property <string> more: "M 10.25 6 A 1.75 1.75 0 1 0 13.75 6 A 1.75 1.75 0 1 0 10.25 6 Z M 10.25 12 A 1.75 1.75 0 1 0 13.75 12 A 1.75 1.75 0 1 0 10.25 12 Z M 10.25 18 A 1.75 1.75 0 1 0 13.75 18 A 1.75 1.75 0 1 0 10.25 18 Z";
    // Page-info chip of a secure page (Chrome dropped the lock for this "tune" glyph).
    out property <string> tune: "M 4 8 L 11.5 8 M 16.5 8 L 20 8 M 4 16 L 7.5 16 M 12.5 16 L 20 16 M 11.5 8 A 2.5 2.5 0 1 0 16.5 8 A 2.5 2.5 0 1 0 11.5 8 M 7.5 16 A 2.5 2.5 0 1 0 12.5 16 A 2.5 2.5 0 1 0 7.5 16";
    out property <string> warning: "M 12 4 L 20.5 19 L 3.5 19 Z M 12 10 L 12 13.5 M 12 16.2 L 12 16.4";
    out property <string> search: "M 4 10 A 6 6 0 1 0 16 10 A 6 6 0 1 0 4 10 M 14.5 14.5 L 20 20";
    out property <string> globe: "M 3.5 12 A 8.5 8.5 0 1 0 20.5 12 A 8.5 8.5 0 1 0 3.5 12 M 3.5 12 L 20.5 12 M 12 3.5 A 5 8.5 0 0 0 12 20.5 A 5 8.5 0 0 0 12 3.5";
    out property <string> import: "M 12 3 L 12 15 M 7 10 L 12 15 L 17 10 M 4 20 L 20 20";
    out property <string> edit: "M 4 20 L 8 19 L 19.5 7.5 A 2 2 0 0 0 16.5 4.5 L 5 16 Z M 15 6 L 18 9";
    // Caption glyphs, drawn in a 10x10 box.
    out property <string> private: "M 2 9 L 22 9 M 3 9 A 4.5 4.5 0 0 0 10 15 L 14 15 A 4.5 4.5 0 0 0 21 9 M 7 9 L 9 5 L 15 5 L 17 9";
    out property <string> caption-minimize: "M 0 5 L 10 5";
    out property <string> caption-maximize: "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z";
    out property <string> caption-restore: "M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z M 2.5 2.5 L 2.5 0.5 L 9.5 0.5 L 9.5 7.5 L 7.5 7.5";
    out property <string> caption-close: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
    out property <string> devtools: "M 4 5 L 20 5 L 20 19 L 4 19 Z M 4 10 L 20 10 M 8 14 L 11 14";
}

// Round toolbar button with Chrome's 34px circular hover.
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    // Draws the icon filled in the accent color (e.g. a bookmarked star).
    in property <bool> highlighted;
    // Draws the icon as a filled shape (the ⋮ dots) instead of an outline.
    in property <bool> solid;
    // Keeps the pressed look while the page this button opens is showing.
    in property <bool> active;
    in property <length> size: 34px;
    in property <length> icon-size: 20px;
    in property <color> icon-color: Theme.icon;
    callback clicked;

    width: root.size;
    height: root.size;
    border-radius: self.height / 2;
    background: !root.enabled ? transparent : touch.pressed || root.active ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.solid ? transparent : !root.enabled ? Theme.disabled : root.highlighted ? Theme.accent : root.icon-color;
        fill: root.solid ? (root.enabled ? root.icon-color : Theme.disabled) : root.highlighted ? Theme.accent : transparent;
        stroke-width: 1.75px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}

component WindowButton inherits Rectangle {
    in property <string> icon;
    in property <bool> danger;
    callback clicked;

    width: 46px;
    background: touch.pressed
        ? (root.danger ? #b01b14 : Theme.pressed)
        : touch.has-hover ? (root.danger ? Theme.danger : Theme.hover) : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.icon;
        stroke: root.danger && touch.has-hover ? #ffffff : Theme.text;
        stroke-width: 1px;
    }
}

// Chrome's loading throbber: a 270° arc turning once every 0.9s. Only exists while a tab loads,
// so the per-frame redraw it causes stops with the load.
component Throbber inherits Path {
    in property <color> color: Theme.accent;
    property <angle> turn: (animation-tick() / 1ms) * 0.4deg;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: root.color;
    stroke-width: 2px;
    stroke-line-cap: round;
    MoveTo {
        x: 8 + 6 * Math.cos(root.turn);
        y: 8 + 6 * Math.sin(root.turn);
    }

    ArcTo {
        x: 8 + 6 * Math.cos(root.turn + 270deg);
        y: 8 + 6 * Math.sin(root.turn + 270deg);
        radius-x: 6;
        radius-y: 6;
        large-arc: true;
        sweep: true;
    }
}

// One tab's body. The strip places it 3px inside its slot; the active one grows concave feet past
// both bottom corners so it flows into the toolbar, the way Chrome draws it.
component TabItem inherits Rectangle {
    in property <TabData> tab;
    in property <bool> active;
    // Pinned tabs, and background tabs squeezed too narrow for a title, show just the favicon.
    in property <bool> compact;
    // Narrow background tabs drop the close button so the favicon keeps its room, as in Chrome.
    in property <bool> closable: true;
    // The divider at the right end of the slot (hidden next to the active or hovered tab).
    in property <bool> separator;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    callback close;
    callback context-menu;

    // A private tab is dark while in the background; once active it joins the white toolbar.
    property <bool> dark: root.tab.private && !root.active;
    // The solid color behind the title, for its fade-out.
    property <color> fill: root.active ? Theme.surface
        : root.dark ? (touch.has-hover ? Theme.private-tab-hover : Theme.private-tab)
        : touch.has-hover ? Theme.tab-hover : Theme.frame;

    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    // Idle background tabs stay transparent so they never paint over the active tab's flare.
    background: root.active || root.dark || touch.has-hover ? root.fill : transparent;

    // Measured off Chrome: the foot runs out at about 45° and turns flat at the bottom, ~10px
    // past the body. A filled Path, since the software renderer caps an 8px box's radius at 4px.
    if root.active: Path {
        x: -10px;
        y: parent.height - 8px;
        width: 10px;
        height: 8px;
        viewbox-width: 10;
        viewbox-height: 8;
        commands: "M 10 0 L 4.5 5.5 Q 2.5 8 0 8 L 10 8 Z";
        fill: Theme.surface;
    }
    if root.active: Path {
        x: parent.width;
        y: parent.height - 8px;
        width: 10px;
        height: 8px;
        viewbox-width: 10;
        viewbox-height: 8;
        commands: "M 0 0 L 5.5 5.5 Q 7.5 8 10 8 L 0 8 Z";
        fill: Theme.surface;
    }

    if root.separator: Rectangle {
        x: parent.width + 2px;
        y: 6px;
        width: 1px;
        height: 16px;
        background: Theme.separator;
    }

    touch := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                root.close();
            } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.context-menu();
            }
        }
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: root.compact ? 0px : 8px;
        padding-right: root.compact ? 0px : 6px;
        // Chrome centers tab contents a little above the middle of the body.
        padding-bottom: 2px;
        spacing: 8px;
        alignment: root.compact ? LayoutAlignment.center : LayoutAlignment.stretch;

        Rectangle {
            width: 16px;
            if root.tab.loading: Throbber {
                y: (parent.height - self.height) / 2;
            }
            if !root.tab.loading && root.tab.private: Path {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.private;
                stroke: root.dark ? #d8d8e4 : Theme.icon;
                stroke-width: 1.5px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
            if !root.tab.loading && !root.tab.private && root.tab.favicon.width > 0: Image {
                y: (parent.height - self.height) / 2;
                source: root.tab.favicon;
                width: 16px;
                height: 16px;
                image-fit: contain;
            }
            if !root.tab.loading && !root.tab.private && root.tab.favicon.width == 0: Path {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.globe;
                stroke: Theme.icon;
                stroke-width: 1.4px;
                stroke-line-cap: round;
            }
            // A discarded tab's icon is washed out, so freed tabs read at a glance. A veil rather
            // than `opacity`, which would need a layer the software renderer composites slowly.
            if root.tab.discarded && !root.tab.loading: Rectangle {
                y: (parent.height - self.height) / 2;
                height: 16px;
                background: root.fill.with-alpha(0.55);
            }
        }

        if !root.compact: Rectangle {
            horizontal-stretch: 1;
            // `overflow: clip` only stops eliding; the text itself spills unless the parent clips,
            // and a clipped title would otherwise claim its whole width as this box's minimum.
            clip: true;
            min-width: 0px;
            title := Text {
                width: 100%;
                height: 100%;
                text: root.tab.title != "" ? root.tab.title : root.tab.url != "" ? root.tab.url : root.tab.private ? "無痕分頁" : "新分頁";
                font-size: 12px;
                vertical-alignment: center;
                overflow: clip;
                color: root.dark ? #e8e8f0 : root.tab.discarded ? Theme.dim : root.active ? Theme.text : Theme.icon;
            }
            // Long titles fade out instead of ending in "…", as in Chrome and Firefox.
            if title.preferred-width > title.width: Rectangle {
                x: parent.width - 24px;
                width: 24px;
                background: @linear-gradient(90deg, root.fill.with-alpha(0) 0%, root.fill 100%);
            }
        }

        if root.closable && !root.compact: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: close-touch.pressed ? Theme.pressed : close-touch.has-hover ? Theme.hover : transparent;
                close-touch := TouchArea {
                    clicked => {
                        root.close();
                    }
                }

                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.close;
                    stroke: root.dark ? #e8e8f0 : Theme.icon;
                    stroke-width: 1.75px;
                    stroke-line-cap: round;
                }
            }
        }
    }
}

// A row of the omnibox dropdown; its icon and text line up with the omnibox's own.
component SuggestionRow inherits Rectangle {
    in property <SuggestionData> item;
    in property <bool> selected;
    callback clicked;
    callback middle-clicked;

    height: 36px;
    background: root.selected ? Theme.hover : touch.has-hover ? Theme.row-hover : transparent;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                root.middle-clicked();
            }
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 16px;
        Rectangle {
            width: 22px;
            Path {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.item.kind == "search" ? Icons.search : root.item.kind == "bookmark" ? Icons.star : root.item.kind == "history" ? Icons.history : Icons.globe;
                stroke: Theme.icon;
                stroke-width: 1.75px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }

        Rectangle {
            width: 8px;
        }

        Text {
            text: root.item.title;
            font-size: 14px;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            max-width: self.preferred-width;
        }

        if root.item.kind == "bookmark" || root.item.kind == "history": Text {
            text: " – " + root.item.url;
            font-size: 14px;
            color: Theme.accent;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.item.kind != "bookmark" && root.item.kind != "history": Rectangle {
            horizontal-stretch: 1;
        }
    }
}

component LinkRow inherits Rectangle {
    in property <string> title;
    in property <string> url;
    in property <string> detail;
    in property <bool> removable;
    in property <bool> editable;
    in property <string> icon: Icons.globe;
    in property <image> favicon;
    callback clicked;
    callback middle-clicked;
    callback remove;
    callback edit;

    height: 48px;
    background: touch.has-hover ? Theme.row-hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                root.middle-clicked();
            }
        }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            if root.favicon.width > 0: Image {
                source: root.favicon;
                width: 16px;
                height: 16px;
                image-fit: contain;
            }
            if root.favicon.width == 0: Path {
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
                stroke: Theme.icon;
                stroke-width: 1.4px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 1px;
            Text {
                text: root.title;
                overflow: elide;
                color: Theme.text;
            }

            if root.url != "" && root.url != root.title: Text {
                text: root.url;
                overflow: elide;
                font-size: 12px;
                color: Theme.dim;
            }
        }

        if root.detail != "": Text {
            text: root.detail;
            vertical-alignment: center;
            font-size: 12px;
            color: Theme.dim;
        }

        if root.editable: VerticalLayout {
            alignment: center;
            IconButton {
                size: 32px;
                icon-size: 18px;
                icon: Icons.edit;
                clicked => {
                    root.edit();
                }
            }
        }

        if root.removable: VerticalLayout {
            alignment: center;
            IconButton {
                size: 32px;
                icon-size: 18px;
                icon: Icons.close;
                clicked => {
                    root.remove();
                }
            }
        }
    }
}

// Chrome's rounded buttons: filled accent for the main action, outlined for the rest.
component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    horizontal-stretch: 0;
    preferred-width: label.preferred-width + 32px;
    min-width: self.preferred-width;
    max-width: self.preferred-width;
    border-radius: 16px;
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.outline;
    background: root.primary
        ? (!root.enabled ? Theme.hover : touch.pressed ? #0a4cb8 : touch.has-hover ? #1a62d6 : Theme.accent)
        : (root.enabled && touch.pressed ? #0b57d024 : root.enabled && touch.has-hover ? #0b57d014 : transparent);

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    label := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        font-weight: 600;
        color: !root.enabled ? Theme.disabled : root.primary ? #ffffff : Theme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Material switch, for the on/off settings.
component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled;

    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.accent : #e3e3e3;
    border-width: root.checked ? 0px : 1.5px;
    border-color: #747775;

    Rectangle {
        width: root.checked ? 14px : 10px;
        height: self.width;
        border-radius: self.width / 2;
        x: root.checked ? root.width - self.width - 3px : 5px;
        y: (root.height - self.height) / 2;
        background: root.checked ? #ffffff : #747775;
    }

    TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component SearchField inherits Rectangle {
    in property <string> placeholder;
    callback edited(string);

    height: 32px;
    border-radius: 16px;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.search;
                stroke: Theme.icon;
                stroke-width: 1.75px;
                stroke-line-cap: round;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            if input.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.dim;
                vertical-alignment: center;
            }
            input := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                single-line: true;
                color: Theme.text;
                edited => {
                    root.edited(self.text);
                }
            }
        }
    }
}

component PageHeader inherits HorizontalLayout {
    in property <string> title;
    spacing: 8px;
    height: 40px;
    padding-top: 4px;
    padding-bottom: 4px;
    Text {
        text: root.title;
        font-size: 22px;
        vertical-alignment: center;
        color: Theme.text;
        horizontal-stretch: 1;
    }
    @children
}

// Internal pages: a column at most 760px wide, centered on the tinted page background.
component PageColumn inherits HorizontalLayout {
    // `start` inside a ScrollView, so short pages keep their cards at natural height instead of
    // stretching them to the window; list pages stretch their one card to the bottom.
    in property <LayoutAlignment> vertical: stretch;
    alignment: center;
    padding: 24px;
    Rectangle {
        preferred-width: 760px;
        max-width: 760px;
        horizontal-stretch: 1;
        VerticalLayout {
            alignment: root.vertical;
            spacing: 12px;
            @children
        }
    }
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 12px;
}

component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Theme.text;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// A settings row: label (and an optional explanation) on the left, its control on the right.
component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> sub;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.text;
            wrap: word-wrap;
        }

        if root.sub != "": Text {
            text: root.sub;
            font-size: 12px;
            color: Theme.dim;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        @children
    }
}

component NtpTile inherits Rectangle {
    in property <LinkData> link;
    callback clicked;
    callback middle-clicked;

    width: 112px;
    height: 112px;
    border-radius: 12px;
    background: touch.has-hover ? Theme.row-hover : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                root.middle-clicked();
            }
        }
    }

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 16px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: #f1f3f4;
        if root.link.favicon.width > 0: Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 24px;
            height: 24px;
            source: root.link.favicon;
            image-fit: contain;
        }
        if root.link.favicon.width == 0: Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 24px;
            height: 24px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: Icons.globe;
            stroke: Theme.icon;
            stroke-width: 1.4px;
        }
    }

    Text {
        x: 8px;
        y: 74px;
        width: parent.width - 16px;
        text: root.link.title;
        font-size: 12px;
        color: Theme.text;
        horizontal-alignment: center;
        overflow: elide;
    }
}

component EmptyText inherits Text {
    color: Theme.dim;
    horizontal-alignment: center;
    wrap: word-wrap;
}

export component AppWindow inherits Window {
    // ---- state pushed from Rust ----
    in property <[TabData]> tabs;
    in property <int> active-tab;
    in property <int> pinned-count;
    in-out property <string> address;
    // The active tab's URL, and how the omnibox shows it while not being edited (no scheme, no
    // lone trailing slash, as Chrome and Firefox do).
    in property <string> page-url;
    in property <string> display-address;
    // "secure" (https), "insecure" (http) or "" for anything else; picks the omnibox's site icon.
    in property <string> site-kind;
    in property <bool> can-go-back;
    in property <bool> can-go-forward;
    in property <bool> loading;
    in property <bool> bookmarked;
    in property <Page> page: Page.new-tab;
    in property <bool> suggestions-open;
    in property <[SuggestionData]> suggestions;
    in-out property <int> selected-suggestion: -1;
    in property <[LinkData]> bookmark-items;
    in property <[LinkData]> history-items;
    in property <[LinkData]> top-sites;
    in property <[ExtensionData]> extensions;
    in property <string> extensions-message;
    in property <bool> extension-installing;
    in property <string> status-text;
    in property <string> memory-text;
    in property <bool> memory-over;
    // Error banner (e.g. WebView2 runtime missing). Empty = hidden.
    in property <string> notice;
    in property <SettingsData> settings;
    in property <string> data-dir;
    in property <string> app-version;
    // Empty unless the MCP endpoint is running.
    in property <string> mcp-url;
    in property <string> window-title: "LiteBrowser";
    in-out property <[ImportProfileData]> import-profiles;
    // Index of the bookmark being edited on the bookmarks page, or -1.
    in-out property <int> editing-bookmark: -1;
    in property <string> import-message;

    // ---- geometry of the web content area in logical pixels, read by Rust ----
    // The page WebView fills `web-slot` (the whole content area, or what is left of it when DevTools
    // is docked); the DevTools WebView fills whichever dock slot is active. Rust reads these to
    // position both native views.
    out property <length> web-view-x: web-slot.absolute-position.x;
    out property <length> web-view-y: web-slot.absolute-position.y;
    out property <length> web-view-width: web-slot.width;
    out property <length> web-view-height: web-slot.height;
    out property <length> devtools-x: root.devtools-right ? devtools-side.absolute-position.x : devtools-bottom.absolute-position.x;
    out property <length> devtools-y: root.devtools-right ? devtools-side.absolute-position.y : devtools-bottom.absolute-position.y;
    out property <length> devtools-width: root.devtools-right ? devtools-side.width : devtools-bottom.width;
    out property <length> devtools-height: root.devtools-right ? devtools-side.height : devtools-bottom.height;
    // True while a page is playing full screen, or the user pressed F11: every piece of
    // browser chrome goes away and the page gets the whole window.
    in property <bool> fullscreen;
    in property <bool> devtools-open;
    // false = docked at the bottom, true = docked on the right.
    in property <bool> devtools-right;
    in-out property <float> devtools-fraction: 0.4;

    // ---- callbacks into Rust ----
    callback content-geometry-changed();
    callback command(string);
    callback select-tab(int);
    callback close-tab(int);
    callback tab-context-menu(int);
    // The ⋮ button; its bottom-right corner in window coordinates, where the menu hangs from.
    callback main-menu(length, length);
    // Right-click on the omnibox; Rust shows a native edit menu (a Slint one would sink under
    // the WebView) and answers through address-action().
    callback address-menu();
    callback navigate(string);
    callback open-url(string);
    callback open-url-new-tab(string);
    callback go-back();
    callback go-forward();
    callback reload();
    callback stop();
    callback address-edited(string);
    callback address-focus-changed(bool);
    callback close-suggestions();
    callback show-page(Page);
    callback remove-bookmark(int);
    callback save-bookmark(int, string, string);
    callback history-search(string);
    callback remove-history(string);
    callback clear-history();
    callback toggle-extension(string, bool);
    callback remove-extension(string);
    callback open-extensions-folder();
    callback reload-extensions();
    callback install-extension(string);
    callback open-data-folder();
    callback save-settings(SettingsData);
    callback dismiss-notice();
    callback refresh-import();
    callback import-run(bool, bool);
    callback import-passwords-csv();
    callback toggle-devtools();
    callback devtools-dock-menu();

    public function focus-address() {
        address-input.focus();
        address-input.select-all();
    }

    public function address-action(action: string) {
        if (action == "undo") {
            address-input.undo();
        } else if (action == "cut") {
            address-input.cut();
        } else if (action == "copy") {
            address-input.copy();
        } else if (action == "paste") {
            address-input.paste();
        } else if (action == "select-all") {
            address-input.select-all();
        }
    }

    title: root.window-title;
    // Tabs sit at the very top like Chrome, so the system title bar is gone and the tab strip
    // doubles as the caption (drag to move, double-click to maximize).
    no-frame: true;
    in property <bool> window-maximized;
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 520px;
    min-height: 360px;
    background: Theme.surface;
    default-font-size: 13px;
    forward-focus: keys;

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    keys := FocusScope {
        // Browser shortcuts while a Slint element has focus. (When the web page has focus, the
        // same shortcuts come from WebView2's AcceleratorKeyPressed event instead.)
        capture-key-pressed(e) => {
            if (address-input.has-focus && root.suggestions-open) {
                if (e.text == Key.DownArrow) {
                    root.selected-suggestion = min(root.selected-suggestion + 1, root.suggestions.length - 1);
                    return accept;
                }
                if (e.text == Key.UpArrow) {
                    root.selected-suggestion = max(root.selected-suggestion - 1, -1);
                    return accept;
                }
            }
            if (e.text == Key.Escape && (root.suggestions-open || address-input.has-focus)) {
                root.close-suggestions();
                return accept;
            }
            // Clipboard shortcuts for the address bar. Slint's built-in text editing only matches
            // lowercase letters, so with Caps Lock on (text comes through uppercase) copy/paste/cut
            // would silently do nothing. Handle both cases here explicitly.
            if (address-input.has-focus && e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift) {
                if (e.text == "c" || e.text == "C") {
                    address-input.copy();
                    return accept;
                }
                if (e.text == "x" || e.text == "X") {
                    address-input.cut();
                    return accept;
                }
                if (e.text == "v" || e.text == "V") {
                    address-input.paste();
                    return accept;
                }
                if (e.text == "a" || e.text == "A") {
                    address-input.select-all();
                    return accept;
                }
                if (e.text == "z" || e.text == "Z") {
                    address-input.undo();
                    return accept;
                }
            }
            if (e.modifiers.control && e.modifiers.shift && (e.text == "i" || e.text == "I")) {
                root.toggle-devtools();
                return accept;
            }
            if (e.modifiers.control && !e.modifiers.alt) {
                if (e.modifiers.shift) {
                    if (e.text == "t" || e.text == "T") {
                        root.command("reopen-tab");
                        return accept;
                    }
                    if (e.text == "n" || e.text == "N") {
                        root.command("new-private-tab");
                        return accept;
                    }
                    if (e.text == "o" || e.text == "O") {
                        root.command("bookmarks");
                        return accept;
                    }
                    if (e.text == Key.Tab || e.text == Key.Backtab) {
                        root.command("prev-tab");
                        return accept;
                    }
                    return reject;
                }
                if (e.text == "t" || e.text == "T" || e.text == "n" || e.text == "N") {
                    root.command("new-tab");
                    return accept;
                }
                if (e.text == "w" || e.text == "W" || e.text == Key.F4) {
                    root.command("close-tab");
                    return accept;
                }
                if (e.text == "l" || e.text == "L") {
                    root.focus-address();
                    return accept;
                }
                if (e.text == "d" || e.text == "D") {
                    root.command("bookmark");
                    return accept;
                }
                if (e.text == "h" || e.text == "H") {
                    root.command("history");
                    return accept;
                }
                if (e.text == "j" || e.text == "J") {
                    root.command("downloads");
                    return accept;
                }
                if (e.text == "r" || e.text == "R") {
                    root.command("reload");
                    return accept;
                }
                if (e.text == Key.Tab || e.text == Key.PageDown) {
                    root.command("next-tab");
                    return accept;
                }
                if (e.text == Key.PageUp) {
                    root.command("prev-tab");
                    return accept;
                }
                if (e.text == "9") {
                    root.command("last-tab");
                    return accept;
                }
                if (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4" || e.text == "5" || e.text == "6" || e.text == "7" || e.text == "8") {
                    root.command("tab-" + e.text);
                    return accept;
                }
            }
            if (e.modifiers.alt && !e.modifiers.control) {
                if (e.text == "d" || e.text == "D") {
                    root.focus-address();
                    return accept;
                }
                if (e.text == Key.LeftArrow) {
                    root.go-back();
                    return accept;
                }
                if (e.text == Key.RightArrow) {
                    root.go-forward();
                    return accept;
                }
            }
            if (e.text == Key.F6) {
                root.focus-address();
                return accept;
            }
            if (e.text == Key.F5) {
                root.command("reload");
                return accept;
            }
            if (e.text == Key.F12) {
                root.toggle-devtools();
                return accept;
            }
            if (e.text == Key.F11) {
                root.command("fullscreen");
                return accept;
            }
            if (e.text == Key.Escape && root.fullscreen) {
                root.command("exit-fullscreen");
                return accept;
            }
            reject
        }

        VerticalLayout {
            // ---------------- tab strip ----------------
            tab-strip := Rectangle {
                height: root.fullscreen ? 0px : 40px;
                background: Theme.frame;
                clip: true;

                // The empty part of the strip is the window caption: drag to move the window,
                // double-click to maximize. Tabs and buttons sit above it and stay clickable.
                WindowMoveArea {
                    width: 100%;
                    height: 100%;
                    TouchArea {
                        double-clicked => {
                            root.toggle-maximize-window();
                        }
                    }
                }

                // Tabs are laid out in slots: pinned tabs (always the first `pinned-count`) get a
                // compact slot, the rest share the space up to Chrome's 238px pitch.
                property <length> pin-w: 44px;
                property <length> start: 5px;
                // 138px of caption buttons plus room for the "+" button.
                property <length> normal-w: clamp(
                    (self.width - self.start - 186px - root.pinned-count * self.pin-w) / max(1, root.tabs.length - root.pinned-count),
                    48px, 238px);
                property <int> hover-index: -1;

                function tab-x(i: int) -> length {
                    if (i < root.pinned-count) {
                        return self.start + i * self.pin-w;
                    }
                    return self.start + root.pinned-count * self.pin-w + (i - root.pinned-count) * self.normal-w;
                }
                function tab-w(i: int) -> length {
                    return i < root.pinned-count ? self.pin-w : self.normal-w;
                }

                for t[i] in root.tabs: TabItem {
                    x: tab-strip.tab-x(i) + 3px;
                    y: 6px;
                    width: tab-strip.tab-w(i) - 6px;
                    height: parent.height - 6px;
                    tab: t;
                    active: i == root.active-tab;
                    compact: t.pinned || (tab-strip.normal-w < 56px && i != root.active-tab);
                    closable: i == root.active-tab || tab-strip.normal-w >= 96px;
                    separator: i != root.active-tab && i + 1 != root.active-tab && i != tab-strip.hover-index && i + 1 != tab-strip.hover-index;
                    changed hovered => {
                        if (self.hovered) {
                            tab-strip.hover-index = i;
                        } else if (tab-strip.hover-index == i) {
                            tab-strip.hover-index = -1;
                        }
                    }
                    clicked => {
                        root.select-tab(i);
                    }
                    close => {
                        root.close-tab(i);
                    }
                    context-menu => {
                        root.tab-context-menu(i);
                    }
                }

                IconButton {
                    x: min(tab-strip.tab-x(root.tabs.length) + 3px, parent.width - caption-buttons.width - self.width - 8px);
                    y: 6px;
                    size: 28px;
                    icon: Icons.plus;
                    clicked => {
                        root.command("new-tab");
                    }
                }

                caption-buttons := HorizontalLayout {
                    x: parent.width - self.width;
                    width: 138px;
                    height: parent.height;

                    WindowButton {
                        icon: Icons.caption-minimize;
                        clicked => {
                            root.minimize-window();
                        }
                    }

                    WindowButton {
                        icon: root.window-maximized ? Icons.caption-restore : Icons.caption-maximize;
                        clicked => {
                            root.toggle-maximize-window();
                        }
                    }

                    WindowButton {
                        icon: Icons.caption-close;
                        danger: true;
                        clicked => {
                            root.close-window();
                        }
                    }
                }
            }

            // ---------------- toolbar ----------------
            Rectangle {
                height: root.fullscreen ? 0px : 46px;
                background: Theme.surface;
                clip: true;

                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 2px;

                    IconButton {
                        icon: Icons.back;
                        enabled: root.can-go-back;
                        clicked => {
                            root.go-back();
                        }
                    }

                    IconButton {
                        icon: Icons.forward;
                        enabled: root.can-go-forward;
                        clicked => {
                            root.go-forward();
                        }
                    }

                    IconButton {
                        icon: root.loading ? Icons.close : Icons.reload;
                        clicked => {
                            if (root.loading) {
                                root.stop();
                            } else {
                                root.reload();
                            }
                        }
                    }

                    Rectangle {
                        width: 7px;
                    }

                    // The omnibox is drawn over this slot further down (see `omnibox`).
                    omni-slot := Rectangle {
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 6px;
                    }

                    IconButton {
                        icon: Icons.puzzle;
                        active: root.page == Page.extensions;
                        clicked => {
                            root.show-page(Page.extensions);
                        }
                    }

                    IconButton {
                        icon: Icons.more;
                        solid: true;
                        clicked => {
                            root.main-menu(self.absolute-position.x + self.width, self.absolute-position.y + self.height);
                        }
                    }
                }
            }

            // ---------------- bookmarks bar ----------------
            if !root.fullscreen && root.settings.show-bookmarks-bar && root.bookmark-items.length > 0: Rectangle {
                height: 32px;
                background: Theme.surface;
                clip: true;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 2px;
                    alignment: start;

                    for b in root.bookmark-items: Rectangle {
                        // A bookmark with no real name (title == url) shows just its site icon.
                        property <bool> named: b.title != "" && b.title != b.url;
                        border-radius: 14px;
                        background: chip-touch.pressed ? Theme.pressed : chip-touch.has-hover ? Theme.hover : transparent;
                        max-width: 180px;

                        chip-touch := TouchArea {
                            clicked => {
                                root.open-url(b.url);
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.up && e.button == PointerEventButton.middle) {
                                    root.open-url-new-tab(b.url);
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                if b.favicon.width > 0: Image {
                                    source: b.favicon;
                                    width: 16px;
                                    height: 16px;
                                    image-fit: contain;
                                }
                                if b.favicon.width == 0: Path {
                                    width: 16px;
                                    height: 16px;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: Icons.globe;
                                    stroke: Theme.icon;
                                    stroke-width: 1.4px;
                                    stroke-line-cap: round;
                                }
                            }

                            if parent.named: Text {
                                text: b.title;
                                vertical-alignment: center;
                                overflow: elide;
                                font-size: 12px;
                                color: Theme.text;
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            // ---------------- notice banner ----------------
            if !root.fullscreen && root.notice != "": Rectangle {
                background: #fff4ce;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;
                    Text {
                        text: root.notice;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        color: #3d2e00;
                    }

                    IconButton {
                        icon: Icons.close;
                        size: 28px;
                        icon-size: 18px;
                        clicked => {
                            root.dismiss-notice();
                        }
                    }
                }
            }

            // ---------------- content ----------------
            content := Rectangle {
                vertical-stretch: 1;
                background: Theme.surface;
                property <bool> dock: root.devtools-open && root.page == Page.web;
                property <bool> dock-bottom: content.dock && !root.devtools-right;
                property <bool> dock-side: content.dock && root.devtools-right;
                property <float> frac: clamp(root.devtools-fraction, 0.15, 0.8);

                // WebView host slots. The page WebView always covers `web-slot`; DevTools covers
                // `devtools-bottom` or `devtools-side` depending on where it is docked. The splits are
                // driven by stretch factors (not by referencing content.width/height, which would
                // create a layout binding loop). The inactive slot gets stretch 0, so it collapses.
                HorizontalLayout {
                    VerticalLayout {
                        horizontal-stretch: content.dock-side ? 1 - content.frac : 1;

                        web-slot := Rectangle {
                            vertical-stretch: content.dock-bottom ? 1 - content.frac : 1;
                            changed width => {
                                root.content-geometry-changed();
                            }
                            changed height => {
                                root.content-geometry-changed();
                            }
                            changed absolute-position => {
                                root.content-geometry-changed();
                            }
                        }

                        // Splitter above a bottom-docked DevTools (a thin Slint strip, never covered
                        // by a WebView, so it stays clickable).
                        Rectangle {
                            height: content.dock-bottom ? 6px : 0px;
                            vertical-stretch: 0;
                            background: bottom-splitter.has-hover ? Theme.accent : Theme.border;
                            bottom-splitter := TouchArea {
                                mouse-cursor: row-resize;
                                property <float> start-fraction;
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down) {
                                        self.start-fraction = root.devtools-fraction;
                                    } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                        root.devtools-dock-menu();
                                    }
                                }
                                moved => {
                                    if (content.dock-bottom && self.pressed) {
                                        root.devtools-fraction = clamp(
                                            self.start-fraction - (self.mouse-y - self.pressed-y) / max(1px, content.height),
                                            0.15, 0.8);
                                    }
                                }
                            }
                        }

                        devtools-bottom := Rectangle {
                            vertical-stretch: content.dock-bottom ? content.frac : 0;
                            changed height => {
                                root.content-geometry-changed();
                            }
                            changed absolute-position => {
                                root.content-geometry-changed();
                            }
                        }
                    }

                    // Splitter left of a right-docked DevTools.
                    Rectangle {
                        width: content.dock-side ? 6px : 0px;
                        horizontal-stretch: 0;
                        background: side-splitter.has-hover ? Theme.accent : Theme.border;
                        side-splitter := TouchArea {
                            mouse-cursor: col-resize;
                            property <float> start-fraction;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    self.start-fraction = root.devtools-fraction;
                                } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                                    root.devtools-dock-menu();
                                }
                            }
                            moved => {
                                if (content.dock-side && self.pressed) {
                                    root.devtools-fraction = clamp(
                                        self.start-fraction - (self.mouse-x - self.pressed-x) / max(1px, content.width),
                                        0.15, 0.8);
                                }
                            }
                        }
                    }

                    devtools-side := Rectangle {
                        horizontal-stretch: content.dock-side ? content.frac : 0;
                        changed width => {
                            root.content-geometry-changed();
                        }
                        changed absolute-position => {
                            root.content-geometry-changed();
                        }
                    }
                }

                if !root.suggestions-open && root.page == Page.web && !root.devtools-open: EmptyText {
                    width: parent.width;
                    height: parent.height;
                    text: root.loading ? "載入中…" : "";
                    vertical-alignment: center;
                }

                // New tab page: a search box that hands off to the omnibox, and the most visited
                // sites as tiles, laid out like Chrome's.
                if root.page == Page.new-tab: ntp := Rectangle {
                    background: Theme.surface;
                    // Rows of up to five; eight tiles split evenly into 4 + 4.
                    property <int> cols: root.top-sites.length <= 5 ? root.top-sites.length : Math.ceil(root.top-sites.length / 2);
                    property <length> top: max(24px, (self.height - 370px) * 0.4);

                    Text {
                        y: ntp.top;
                        width: parent.width;
                        text: "LiteBrowser";
                        font-size: 36px;
                        font-weight: 600;
                        color: Theme.text;
                        horizontal-alignment: center;
                    }

                    fakebox := Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: ntp.top + 68px;
                        width: min(584px, parent.width - 64px);
                        height: 46px;
                        border-radius: 23px;
                        background: fake-touch.has-hover ? Theme.field-hover : Theme.field;
                        fake-touch := TouchArea {
                            mouse-cursor: text;
                            clicked => {
                                root.focus-address();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    commands: Icons.search;
                                    stroke: Theme.icon;
                                    stroke-width: 1.75px;
                                    stroke-line-cap: round;
                                }
                            }

                            Text {
                                text: "搜尋或輸入網址";
                                font-size: 15px;
                                color: Theme.dim;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    for t[i] in root.top-sites: NtpTile {
                        x: (ntp.width - ntp.cols * 112px) / 2 + Math.mod(i, ntp.cols) * 112px;
                        y: fakebox.y + fakebox.height + 32px + Math.floor(i / ntp.cols) * 112px;
                        link: t;
                        clicked => {
                            root.open-url(t.url);
                        }
                        middle-clicked => {
                            root.open-url-new-tab(t.url);
                        }
                    }

                    if root.top-sites.length == 0: EmptyText {
                        y: fakebox.y + fakebox.height + 40px;
                        width: parent.width;
                        text: "常去的網站會出現在這裡。";
                    }

                    EmptyText {
                        x: 24px;
                        y: parent.height - self.height - 16px;
                        width: parent.width - 48px;
                        font-size: 12px;
                        text: "小提示：分頁上按滑鼠右鍵可釘選、複製、關閉其他等（釘選的分頁不會被釋放），中鍵＝關閉。圖示變淡的分頁已釋放記憶體，點一下會重新載入。";
                    }
                }

                // Bookmarks page.
                if root.page == Page.bookmarks: Rectangle {
                    background: Theme.page;
                    PageColumn {
                        PageHeader {
                            title: "書籤";
                        }

                        Card {
                            vertical-stretch: 1;
                            if root.bookmark-items.length == 0: EmptyText {
                                y: 32px;
                                width: parent.width;
                                text: "還沒有書籤。開啟網頁後按網址列的 ☆ 或 Ctrl+D 加入。";
                            }
                            ListView {
                                y: 8px;
                                width: parent.width;
                                height: parent.height - 16px;
                                for b[i] in root.bookmark-items: Rectangle {
                                    height: 48px;

                                    if i != root.editing-bookmark: LinkRow {
                                        width: parent.width;
                                        height: parent.height;
                                        title: b.title;
                                        url: b.url;
                                        favicon: b.favicon;
                                        icon: Icons.bookmarks;
                                        editable: true;
                                        removable: true;
                                        clicked => {
                                            root.open-url(b.url);
                                        }
                                        middle-clicked => {
                                            root.open-url-new-tab(b.url);
                                        }
                                        edit => {
                                            root.editing-bookmark = i;
                                        }
                                        remove => {
                                            root.remove-bookmark(i);
                                        }
                                    }

                                    if i == root.editing-bookmark: HorizontalLayout {
                                        width: parent.width;
                                        height: parent.height;
                                        spacing: 8px;
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;

                                        title-edit := LineEdit {
                                            horizontal-stretch: 1;
                                            placeholder-text: "名稱";
                                            text: b.title == b.url ? "" : b.title;
                                            accepted => {
                                                root.save-bookmark(i, self.text, url-edit.text);
                                                root.editing-bookmark = -1;
                                            }
                                        }

                                        url-edit := LineEdit {
                                            horizontal-stretch: 2;
                                            placeholder-text: "網址";
                                            text: b.url;
                                            accepted => {
                                                root.save-bookmark(i, title-edit.text, self.text);
                                                root.editing-bookmark = -1;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            PillButton {
                                                text: "儲存";
                                                primary: true;
                                                clicked => {
                                                    root.save-bookmark(i, title-edit.text, url-edit.text);
                                                    root.editing-bookmark = -1;
                                                }
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            PillButton {
                                                text: "取消";
                                                clicked => {
                                                    root.editing-bookmark = -1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // History page.
                if root.page == Page.history: Rectangle {
                    background: Theme.page;
                    PageColumn {
                        PageHeader {
                            title: "歷史紀錄";
                            SearchField {
                                width: 280px;
                                placeholder: "搜尋歷史紀錄";
                                edited(text) => {
                                    root.history-search(text);
                                }
                            }

                            PillButton {
                                text: "清除全部";
                                clicked => {
                                    root.clear-history();
                                }
                            }
                        }

                        Card {
                            vertical-stretch: 1;
                            if root.history-items.length == 0: EmptyText {
                                y: 32px;
                                width: parent.width;
                                text: "沒有歷史紀錄";
                            }
                            ListView {
                                y: 8px;
                                width: parent.width;
                                height: parent.height - 16px;
                                for h in root.history-items: LinkRow {
                                    title: h.title;
                                    url: h.url;
                                    detail: h.detail;
                                    favicon: h.favicon;
                                    icon: Icons.history;
                                    removable: true;
                                    clicked => {
                                        root.open-url(h.url);
                                    }
                                    middle-clicked => {
                                        root.open-url-new-tab(h.url);
                                    }
                                    remove => {
                                        root.remove-history(h.url);
                                    }
                                }
                            }
                        }
                    }
                }

                // Extensions page.
                if root.page == Page.extensions: Rectangle {
                    background: Theme.page;
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        PageColumn {
                            vertical: start;
                            PageHeader {
                                title: "擴充功能";
                                PillButton {
                                    text: "開啟擴充功能資料夾";
                                    clicked => {
                                        root.open-extensions-folder();
                                    }
                                }

                                PillButton {
                                    text: "重新載入";
                                    clicked => {
                                        root.reload-extensions();
                                    }
                                }
                            }

                            Card {
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 12px;
                                    Text {
                                        text: "貼上 Chrome 線上應用程式商店的網址（或擴充功能 ID），按「安裝」即可下載安裝。";
                                        wrap: word-wrap;
                                        color: Theme.text;
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        store-url := LineEdit {
                                            placeholder-text: "https://chromewebstore.google.com/detail/.../abcdefgh...";
                                            horizontal-stretch: 1;
                                            enabled: !root.extension-installing;
                                            accepted => {
                                                root.install-extension(self.text);
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            PillButton {
                                                text: root.extension-installing ? "安裝中…" : "安裝";
                                                enabled: !root.extension-installing && store-url.text != "";
                                                primary: true;
                                                clicked => {
                                                    root.install-extension(store-url.text);
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "或者，把「解壓縮後」的擴充功能資料夾（含 manifest.json）放進擴充功能資料夾，再按「重新載入」。\n例如 uBlock Origin Lite：到 GitHub 下載 uBOLite_x.x.x.chromium.zip，解壓縮成一個資料夾放進去。\n注意：WebView2 不會顯示擴充功能的工具列按鈕，所以需要點按鈕操作的擴充功能（例如密碼管理器）無法使用。";
                                        wrap: word-wrap;
                                        font-size: 12px;
                                        color: Theme.dim;
                                    }

                                    if root.extensions-message != "": Text {
                                        text: root.extensions-message;
                                        wrap: word-wrap;
                                        color: Theme.text;
                                    }
                                }
                            }

                            if root.extensions.length > 0: Card {
                                VerticalLayout {
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    for ext[i] in root.extensions: VerticalLayout {
                                        if i > 0: Divider { }
                                        SettingRow {
                                            label: ext.name;
                                            HorizontalLayout {
                                                spacing: 16px;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Toggle {
                                                        checked: ext.enabled;
                                                        toggled => {
                                                            root.toggle-extension(ext.id, self.checked);
                                                        }
                                                    }
                                                }

                                                PillButton {
                                                    text: "移除";
                                                    clicked => {
                                                        root.remove-extension(ext.id);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Import page.
                if root.page == Page.import: Rectangle {
                    background: Theme.page;
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        PageColumn {
                            vertical: start;
                            PageHeader {
                                title: "從其他瀏覽器匯入";
                                PillButton {
                                    text: "重新偵測";
                                    clicked => {
                                        root.refresh-import();
                                    }
                                }
                            }

                            SectionTitle {
                                text: "書籤與歷史紀錄";
                            }

                            Card {
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 10px;
                                    Text {
                                        text: "直接讀取瀏覽器的檔案，不需要你先匯出任何東西。\n請先關閉要匯入的瀏覽器（檔案被鎖住就讀不到），再勾選設定檔：";
                                        wrap: word-wrap;
                                        color: Theme.text;
                                    }

                                    if root.import-profiles.length == 0: Text {
                                        text: "找不到已安裝的 Chrome、Edge、Brave 或 Firefox 設定檔。";
                                        color: Theme.dim;
                                    }

                                    for p[i] in root.import-profiles: CheckBox {
                                        text: p.label;
                                        checked: p.selected;
                                        toggled => {
                                            root.import-profiles[i].selected = self.checked;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 16px;
                                        padding-top: 4px;
                                        alignment: start;
                                        import-bookmarks := CheckBox {
                                            text: "書籤";
                                            checked: true;
                                        }

                                        import-history := CheckBox {
                                            text: "歷史紀錄";
                                            checked: true;
                                        }
                                    }

                                    HorizontalLayout {
                                        alignment: start;
                                        PillButton {
                                            text: "匯入勾選的設定檔";
                                            primary: true;
                                            clicked => {
                                                root.import-run(import-bookmarks.checked, import-history.checked);
                                            }
                                        }
                                    }
                                }
                            }

                            SectionTitle {
                                text: "密碼";
                            }

                            Card {
                                VerticalLayout {
                                    padding: 20px;
                                    spacing: 10px;
                                    Text {
                                        text: "只有「密碼」需要你先匯出 CSV，書籤和歷史不用。\n密碼在各瀏覽器裡是加密的，而且 Chrome 新版的 app-bound 加密本來就讀不出來；直接去解別人的密碼庫，寫出來的程式和竊密軟體沒兩樣，所以改走官方匯出。\n做法：在原瀏覽器的密碼設定選「匯出密碼」（會要求你驗證身分）存成 CSV，再按下面的按鈕選擇，然後重新啟動一次 LiteBrowser。";
                                        wrap: word-wrap;
                                        color: Theme.dim;
                                    }

                                    HorizontalLayout {
                                        alignment: start;
                                        PillButton {
                                            text: "選擇密碼 CSV 檔…";
                                            clicked => {
                                                root.import-passwords-csv();
                                            }
                                        }
                                    }

                                    if root.import-message != "": Text {
                                        text: root.import-message;
                                        wrap: word-wrap;
                                        color: Theme.text;
                                    }
                                }
                            }
                        }
                    }
                }

                // Settings page. Every change saves at once, like Chrome's settings; number fields
                // wait a moment so typing "12" does not apply a 1 on the way.
                if root.page == Page.settings: settings-page := Rectangle {
                    background: Theme.page;

                    function save() {
                        root.save-settings({
                            max-live-tabs: live.value,
                            suspend-after-secs: suspend.value,
                            discard-after-mins: discard.value,
                            memory-budget-mb: budget.value,
                            adblock: adblock.checked,
                            disable-gpu: gpu.checked,
                            restore-session: restore.checked,
                            show-bookmarks-bar: bar.checked,
                            search-url: search.text,
                            devtools-dock-right: devtools-dock.checked,
                            mcp-enabled: mcp.checked,
                        });
                    }
                    function save-soon() {
                        save-timer.start();
                        save-timer.restart();
                    }

                    save-timer := Timer {
                        interval: 1s;
                        running: false;
                        triggered => {
                            self.stop();
                            settings-page.save();
                        }
                    }

                    ScrollView {
                        width: 100%;
                        height: 100%;
                        PageColumn {
                            vertical: start;
                            PageHeader {
                                title: "設定";
                            }

                            SectionTitle {
                                text: "記憶體";
                            }

                            Card {
                                VerticalLayout {
                                    SettingRow {
                                        label: "同時保留網頁的分頁數";
                                        sub: "含目前分頁；其餘的背景分頁會被釋放，點回去時重新載入";
                                        live := SpinBox {
                                            width: 120px;
                                            minimum: 1;
                                            maximum: 20;
                                            value: root.settings.max-live-tabs;
                                            edited => {
                                                settings-page.save-soon();
                                            }
                                        }
                                    }

                                    Divider { }

                                    SettingRow {
                                        label: "背景分頁凍結時間（秒）";
                                        sub: "凍結的分頁停止執行，但網頁留在記憶體裡";
                                        suspend := SpinBox {
                                            width: 120px;
                                            minimum: 5;
                                            maximum: 3600;
                                            step-size: 5;
                                            value: root.settings.suspend-after-secs;
                                            edited => {
                                                settings-page.save-soon();
                                            }
                                        }
                                    }

                                    Divider { }

                                    SettingRow {
                                        label: "背景分頁釋放時間（分鐘）";
                                        discard := SpinBox {
                                            width: 120px;
                                            minimum: 1;
                                            maximum: 1440;
                                            value: root.settings.discard-after-mins;
                                            edited => {
                                                settings-page.save-soon();
                                            }
                                        }
                                    }

                                    Divider { }

                                    SettingRow {
                                        label: "記憶體上限（MB）";
                                        sub: "超過時先釋放最佔記憶體的分頁";
                                        budget := SpinBox {
                                            width: 120px;
                                            minimum: 100;
                                            maximum: 16000;
                                            step-size: 50;
                                            value: root.settings.memory-budget-mb;
                                            edited => {
                                                settings-page.save-soon();
                                            }
                                        }
                                    }
                                }
                            }

                            SectionTitle {
                                text: "瀏覽";
                            }

                            Card {
                                VerticalLayout {
                                    SettingRow {
                                        label: "顯示書籤列";
                                        bar := Toggle {
                                            checked: root.settings.show-bookmarks-bar;
                                            toggled => {
                                                settings-page.save();
                                            }
                                        }
                                    }

                                    Divider { }

                                    SettingRow {
                                        label: "啟動時恢復上次的分頁";
                                        restore := Toggle {
                                            checked: root.settings.restore-session;
                                            toggled => {
                                                settings-page.save();
                                            }
                                        }
                                    }

                                    Divider { }

                                    SettingRow {
                                        label: "封鎖廣告與追蹤網域";
                                        sub: "清單是資料夾裡的 blocklist.txt；重新啟動後生效";
                                        adblock := Toggle {
                                            checked: root.settings.adblock;
                                            toggled => {
                                                settings-page.save();
                                            }
                                        }
                                    }

                                    Divider { }

                                    SettingRow {
                                        label: "搜尋網址";
                                        sub: "{} 會換成搜尋文字；按 Enter 儲存";
                                        search := LineEdit {
                                            width: 300px;
                                            text: root.settings.search-url;
                                            accepted => {
                                                settings-page.save();
                                            }
                                        }
                                    }
                                }
                            }

                            SectionTitle {
                                text: "系統";
                            }

                            Card {
                                VerticalLayout {
                                    SettingRow {
                                        label: "停用 GPU";
                                        sub: "VDI 沒有顯示卡時建議開啟；重新啟動後生效";
                                        gpu := Toggle {
                                            checked: root.settings.disable-gpu;
                                            toggled => {
                                                settings-page.save();
                                            }
                                        }
                                    }

                                    Divider { }

                                    SettingRow {
                                        label: "開發人員工具停駐在右側";
                                        sub: "預設在下方；也可以在分隔線上按右鍵切換";
                                        devtools-dock := Toggle {
                                            checked: root.settings.devtools-dock-right;
                                            toggled => {
                                                settings-page.save();
                                            }
                                        }
                                    }

                                    Divider { }

                                    SettingRow {
                                        label: "開啟 MCP 服務";
                                        sub: root.mcp-url != ""
                                            ? "讓 Claude 等 LLM 操作這個瀏覽器（只接受本機連線）。網址每次啟動都會換，也會寫進資料夾的 mcp-url.txt：\n" + root.mcp-url
                                            : root.settings.mcp-enabled
                                            ? "讓 Claude 等 LLM 操作這個瀏覽器（只接受本機連線）。會在下次啟動時開啟。"
                                            : "讓 Claude 等 LLM 操作這個瀏覽器（只接受本機連線）；重新啟動後生效";
                                        mcp := Toggle {
                                            checked: root.settings.mcp-enabled;
                                            toggled => {
                                                settings-page.save();
                                            }
                                        }
                                    }
                                }
                            }

                            SectionTitle {
                                text: "資料";
                            }

                            Card {
                                VerticalLayout {
                                    SettingRow {
                                        label: "從其他瀏覽器匯入";
                                        sub: "Chrome、Edge、Brave、Firefox 的書籤、歷史紀錄與密碼";
                                        PillButton {
                                            text: "匯入…";
                                            clicked => {
                                                root.show-page(Page.import);
                                            }
                                        }
                                    }

                                    Divider { }

                                    SettingRow {
                                        label: "資料夾";
                                        sub: root.data-dir + "\n書籤、歷史紀錄、Cookie 與儲存的密碼都在這裡";
                                        PillButton {
                                            text: "開啟資料夾";
                                            clicked => {
                                                root.open-data-folder();
                                            }
                                        }
                                    }
                                }
                            }

                            Text {
                                text: "LiteBrowser " + root.app-version + "　GPL-3.0";
                                color: Theme.dim;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // ---------------- status bar ----------------
            if !root.fullscreen: Rectangle {
                height: 24px;
                background: Theme.surface;

                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    Text {
                        text: root.status-text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        font-size: 11px;
                        color: Theme.dim;
                    }

                    Text {
                        text: root.memory-text;
                        vertical-alignment: center;
                        font-size: 11px;
                        color: root.memory-over ? Theme.danger : Theme.dim;
                    }
                }
            }
        }

        // ---------------- omnibox ----------------
        // Clicking anywhere below the toolbar closes the suggestions, as clicking the page does.
        if root.suggestions-open: TouchArea {
            y: content.absolute-position.y;
            height: content.height;
            clicked => {
                root.close-suggestions();
            }
        }

        // Drawn over `omni-slot` instead of inside the toolbar: with suggestions open it grows into
        // one card with the list below it, as Chrome's does, and the toolbar clips its children.
        omnibox := Rectangle {
            property <bool> open: root.suggestions-open && root.suggestions.length > 0;
            visible: !root.fullscreen;
            x: omni-slot.absolute-position.x;
            y: omni-slot.absolute-position.y;
            width: omni-slot.width;
            height: self.open ? 38px + root.suggestions.length * 36px + 8px : omni-slot.height;
            border-radius: 17px;
            background: self.open || address-input.has-focus ? Theme.surface : field-touch.has-hover ? Theme.field-hover : Theme.field;
            // No drop shadow in the software renderer, so the open card gets an outline instead.
            border-width: self.open ? 1px : address-input.has-focus ? 2px : 0px;
            border-color: self.open ? Theme.outline : Theme.accent;

            field-touch := TouchArea {
                y: 0;
                height: omni-slot.height;
                mouse-cursor: text;
                clicked => {
                    address-input.focus();
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                        address-input.focus();
                        root.address-menu();
                    }
                }

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 3px;

                    // Page-info chip: a white pill around the site icon (and "不安全" on http),
                    // like Chrome's. While typing it is just a search glyph.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            border-radius: 12px;
                            background: root.site-kind != "" && !root.suggestions-open && !address-input.has-focus ? Theme.surface : transparent;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 4px;
                                VerticalLayout {
                                    alignment: center;
                                    Path {
                                        width: 16px;
                                        height: 16px;
                                        viewbox-width: 24;
                                        viewbox-height: 24;
                                        commands: root.suggestions-open || root.site-kind == "" ? Icons.search : root.site-kind == "secure" ? Icons.tune : Icons.warning;
                                        stroke: Theme.icon;
                                        stroke-width: 1.75px;
                                        stroke-line-cap: round;
                                        stroke-line-join: round;
                                    }
                                }

                                if root.site-kind == "insecure" && !root.suggestions-open: Text {
                                    text: "不安全";
                                    color: Theme.dim;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle {
                        width: 7px;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        if root.address == "" && !address-input.has-focus: Text {
                            width: 100%;
                            height: 100%;
                            text: "搜尋或輸入網址";
                            font-size: 15px;
                            color: Theme.dim;
                            vertical-alignment: center;
                        }

                        // The full URL comes back as soon as the field has focus.
                        if address-input.trimmed: Text {
                            width: 100%;
                            height: 100%;
                            text: root.display-address;
                            font-size: 15px;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // A bare TextInput scrolled the way std LineEdit does it, so the pill can
                        // be drawn here instead of LineEdit's own frame.
                        address-input := TextInput {
                            property <bool> trimmed: !self.has-focus && root.address == root.page-url && root.display-address != root.address;
                            property <length> computed-x;
                            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                            width: max(parent.width - self.text-cursor-width, self.preferred-width);
                            height: 100%;
                            vertical-alignment: center;
                            single-line: true;
                            font-size: 15px;
                            color: self.trimmed ? transparent : Theme.text;
                            selection-background-color: #a8c7fa;
                            selection-foreground-color: Theme.text;
                            text <=> root.address;
                            cursor-position-changed(pos) => {
                                if (pos.x + self.computed-x < 0px) {
                                    self.computed-x = -pos.x;
                                } else if (pos.x + self.computed-x > parent.width - self.text-cursor-width) {
                                    self.computed-x = parent.width - pos.x - self.text-cursor-width;
                                }
                            }
                            edited => {
                                root.selected-suggestion = -1;
                                root.address-edited(self.text);
                            }
                            accepted => {
                                if (root.suggestions-open && root.selected-suggestion >= 0 && root.selected-suggestion < root.suggestions.length) {
                                    root.open-url(root.suggestions[root.selected-suggestion].url);
                                } else {
                                    root.navigate(self.text);
                                }
                            }
                            changed has-focus => {
                                // No select-all here: clicking should place the caret like any text
                                // field. Ctrl+L / Alt+D / F6 go through focus-address(), which selects.
                                if (!self.has-focus) {
                                    self.computed-x = 0px;
                                }
                                root.address-focus-changed(self.has-focus);
                            }
                        }
                    }

                    if root.page == Page.web: VerticalLayout {
                        alignment: center;
                        padding-left: 4px;
                        padding-right: 7px;
                        IconButton {
                            size: 28px;
                            icon: Icons.star;
                            highlighted: root.bookmarked;
                            clicked => {
                                root.command("bookmark");
                            }
                        }
                    }
                }
            }

            if omnibox.open: VerticalLayout {
                y: 38px;
                width: parent.width;
                height: root.suggestions.length * 36px;
                for s[i] in root.suggestions: SuggestionRow {
                    item: s;
                    selected: i == root.selected-suggestion;
                    clicked => {
                        root.open-url(s.url);
                    }
                    middle-clicked => {
                        root.open-url-new-tab(s.url);
                    }
                }
            }
        }
    }
}
